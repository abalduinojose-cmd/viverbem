# Copie este arquivo para .env e ajuste os valores.

# SQLite local (padrão). Em produção, troque o provider com
# "npm run db:mysql" (ou db:postgres) e aponte para o servidor:
# DATABASE_URL="mysql://usuario:senha@servidor:3306/viverbem"
# DATABASE_URL="postgresql://usuario:senha@servidor:5432/viverbem"
DATABASE_URL="file:./dev.db"

# Segredo do cookie de sessão do admin — mínimo 32 caracteres, use um valor aleatório
SESSION_SECRET="troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres"

# Endereço público do site, sem barra no fim (links de compartilhamento,
# sitemap e dados para o Google). Obrigatório em produção.
# NEXT_PUBLIC_SITE_URL="https://www.viverbem.com.br"

# Google Analytics 4 (opcional). Só carrega com o aceite de cookies.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Senhas iniciais do painel em produção (mínimo 8 caracteres). Sem elas,
# o build gera senhas aleatórias e mostra no log, uma vez.
# SEED_ADMIN_SENHA=""
# SEED_OPERADOR_SENHA=""

# Fotos e vídeos na nuvem (Vercel Blob). Sem o token, ficam em public/uploads.
# BLOB_READ_WRITE_TOKEN=""
